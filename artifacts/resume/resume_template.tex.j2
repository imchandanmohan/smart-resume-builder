\begin{document}

%----------HEADING-----------------
\begin{tabular*}{\textwidth}{l@{\extracolsep{\fill}}r}
  \textbf{\href{http://sourabhbajaj.com/}{\Large {{ personal_info.name }}}} & Email: \href{mailto:{{ personal_info.email }}}{ {{ personal_info.email }} }\\
  \href{ {{ personal_info.linkedin }} }{ {{ personal_info.linkedin }} } & Mobile: {{ personal_info.phone }} \\
\end{tabular*}

%-----------EDUCATION-----------------
\section{Education}
\resumeSubHeadingListStart
{% for edu in education %}
  \resumeSubheading
    { {{ edu.institution }} }{ {{ edu.location }} }
    { {{ edu.degree }}; \textbf{GPA: {{ edu.gpa }}} }{ {{ edu.duration }} }
    \vspace{-1.2mm}
    \begin{itemize}[leftmargin=0.5mm, label={}, noitemsep, topsep=0pt, parsep=0pt]
      {% for detail in edu.details %}
      \item \small {{ detail }}
      {% endfor %}
    \end{itemize}
{% endfor %}
\resumeSubHeadingListEnd

%-----------EXPERIENCE-----------------
\section{Experience}
\resumeSubHeadingListStart
{% for exp in experience %}
  \resumeSubheading
    { {{ exp.company }} }{ {{ exp.location }} }
    { {{ exp.title }} }{ {{ exp.duration }} }
  \resumeItemListStart
    {% for proj in exp.projects %}
    \resumeItem{ {{ proj.name }} }
      { {{ proj.description }} }
    {% endfor %}
  \resumeItemListEnd
{% endfor %}
\resumeSubHeadingListEnd

%-----------PROJECTS-----------------
\section{Projects}
\resumeSubHeadingListStart
{% for proj in projects %}
  \resumeSubItem{ {{ proj.title }} (\href{ {{ proj.github }} }{GitHub}) }
  {
    \begin{itemize}[leftmargin=0.5cm]
      {% for d in proj.details %}
      \item {{ d }}
      {% endfor %}
    \end{itemize}
  }
{% endfor %}
\resumeSubHeadingListEnd

%-----------SKILLS-----------------
\section*{Skills}
\begin{tabular}{@{}ll}
{% filter strip_diff %}
{% for category, items in skills.items() %}
-  \textbullet\ \textbf{ {{ category | replace('&','\\&') }}: } & \hspace{1em}{{ items|join(', ') }} \\
{% endfor %}
{% endfilter %}
\end{tabular}



